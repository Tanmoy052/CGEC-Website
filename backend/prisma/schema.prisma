generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  FACULTY
  ADMIN
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  name      String
  role      Role     @default(STUDENT)
  dept      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notice {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  title               String
  content             String
  category            String    @default("General") // General, Academic, Tender, Recruitment
  priority            String    @default("NORMAL")  // NORMAL, HIGH, URGENT
  expiryDate          DateTime?
  attachment          String?
  attachmentPublicId  String?   // Cloudinary public_id for the attachment
  authorId            String?
  authorName          String?
  department          String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Faculty {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  designation       String
  department        String    // CSE, ECE, EE, ME, CE, BSH
  email             String    @unique
  phone             String?
  experience        String?
  specialization    String[]  @default([])
  qualifications    String[]  @default([])
  image             String?
  imagePublicId     String?   // Cloudinary public_id for the photo
  cvLink            String?
  cvPublicId        String?   // Cloudinary public_id for the CV PDF
  publications      String[]  @default([])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Syllabus {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  department      String   // CSE, ECE, EE, ME, CE, BSH
  semester        String   // 1st, 2nd, 3rd, 4th, 5th, 6th, 7th, 8th, All
  title           String
  description     String?
  pdfLink         String
  pdfPublicId     String?  // Cloudinary public_id for the PDF
  academicYear    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Lab {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  department      String   // CSE, ECE, EE, ME, CE
  name            String
  description     String
  image           String?
  imagePublicId   String?  // Cloudinary public_id for the lab photo
  roomNumber      String?
  facultyInCharge String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Gallery {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  category        String   @default("Campus") // Campus, Events, Sports, Labs, Cultural
  imageUrl        String
  imagePublicId   String?  // Cloudinary public_id for the gallery image
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model WallMagazine {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  edition         String?  // e.g. "Vol. 1", "2025 Edition", "Winter 2025"
  year            String?  // e.g. "2025"
  description     String?
  imageUrl        String   // cover image or page scan
  imagePublicId   String?  // Cloudinary public_id for the cover image
  pdfLink         String?  // optional PDF download
  pdfPublicId     String?  // Cloudinary public_id for the PDF
  department      String?  // optional department tag
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AdmissionItem {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  year         String   @default("2025")
  category     String   @default("NOTICE") // NOTICE or DOCUMENT
  title        String
  fileUrl      String
  filePublicId String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AdmissionConfig {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  year               String   @unique @default("2025")
  whatsappLink       String?
  contactPhone       String?
  contactEmail       String?
  officerName        String?
  officerRole        String?
  officerDesignation String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model FeeItem {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  academicYear  String   @default("2025-26")
  admissionType String   @default("REGULAR") // REGULAR (1st sem) or LATERAL (3rd sem)
  slNo          String
  feeHead       String
  cseEce        String
  core          String
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CommitteeMember {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  committee  String   // slug e.g. academic, anti-ragging, anti-ragging-squard, counsellor, grc, icc, iic, iqac, sc-st, student-grc
  name       String
  position   String
  department String?
  phone      String?
  email      String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model LeadershipMessage {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  role          String
  dept          String?
  message       String
  image         String
  imagePublicId String?
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Recruiter {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  logo         String
  logoPublicId String?
  website      String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PlacementBrochure {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String   @default("Placement Brochure")
  description  String?
  academicYear String?  @default("2025-2026")
  fileUrl      String?  @default("")
  filePublicId String?
  fileType     String?  // pdf, doc, docx, ppt, pptx, jpg, png, etc.
  fileName     String?
  fileSize     String?
  isActive     Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}